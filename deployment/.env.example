# Copy to deployment/.env and fill in. docker compose reads this automatically.
#
#   cd deployment
#   cp .env.example .env

# Host port the application is published on -> http://localhost:8080
APP_PORT=8080
APP_URL=http://localhost:8080

APP_ENV=production
APP_DEBUG=false

# Generate with:  docker compose run --rm web php artisan key:generate --show
APP_KEY=

# Database. DB_DATABASE matches the schema this project's migrations expect.
DB_DATABASE=hospital
DB_USERNAME=hospital
DB_PASSWORD=changeme
DB_ROOT_PASSWORD=changeme-root

# Convolutional layer Grad-CAM reads activations from. Both bundled
# classifiers (presys, 1sys) expose Conv1..Conv5.
GRADCAM_LAYER=Conv5

# NOTE: FASTAPI_URL / FASTAPI_URL_2 / FASTAPI_URL_3 are set in
# docker-compose.yml to the internal service names. Do not override them here
# unless you are pointing at model servers outside this Compose project.
